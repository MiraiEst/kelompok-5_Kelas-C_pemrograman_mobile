rules_version = '2';

// Photos only: any signed-in user can read; only the owner of the folder can
// write, files must be images and at most 5 MB.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isImageUnder5Mb() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Listing photos: listings/{uid}/{listingId}/{index}.jpg
    match /listings/{uid}/{listingId}/{file} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid) && isImageUnder5Mb();
      allow delete: if isOwner(uid);
    }

    // Profile photo: users/{uid}/avatar.jpg
    match /users/{uid}/{file} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid) && isImageUnder5Mb();
      allow delete: if isOwner(uid);
    }

    // Evidence for "Report a problem": cases/{uid}/{caseId}/{index}.jpg
    match /cases/{uid}/{caseId}/{file} {
      allow read: if signedIn();
      allow create: if isOwner(uid) && isImageUnder5Mb();
    }
  }
}
